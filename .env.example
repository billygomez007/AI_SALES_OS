# Non-secret configuration example. Set actual credentials in a managed secret store.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/aisales
REDIS_URL=redis://localhost:6379
PUBLIC_BASE_URL=http://localhost:3000
AI_MODEL_PROVIDER=configure-me
WHATSAPP_APP_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Never commit real tokens, client identifiers or production PII.
